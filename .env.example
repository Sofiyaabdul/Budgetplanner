# ==============================================================================
# BUDGET PLANNING SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Backend Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/budget_planning_system

# JWT Authentication
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRE=30d

# Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173
